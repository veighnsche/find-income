{
  "name": "@jobseek/workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/contracts"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "check": "turbo run check:generated && turbo run lint",
    "test": "turbo run test",
    "build": "turbo run build",
    "generate": "turbo run generate",
    "format": "turbo run format",
    "e2e": "bun --filter @jobseek/web build && node scripts/ui-smoke/smoke.mjs",
    "e2e:research": "bun --filter @jobseek/web build && node scripts/ui-smoke/research-smoke.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.63.0",
    "turbo": "2.11.3",
    "vite-plus": "1.0.0-rc.0"
  },
  "engines": {
    "node": "24.21.0",
    "bun": "1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
