# Installed as /etc/jobseek/api.env, root-owned mode 0600; never commit values.
JOBSEEK_DATA_DIR=/var/lib/jobseek/data
JOBSEEK_LISTEN_ADDR=127.0.0.1:8080
JOBSEEK_PUBLIC_ORIGIN=https://PRIVATE_APP_FQDN
JOBSEEK_CODEX_SSH_HOST=RUNNER_PRIVATE_DNS
JOBSEEK_CODEX_SSH_USER=jobseek-runner
JOBSEEK_CODEX_SSH_IDENTITY_FILE=/etc/jobseek/ssh/runner_key
JOBSEEK_CODEX_SSH_KNOWN_HOSTS=/etc/jobseek/ssh/known_hosts
JOBSEEK_CODEX_REMOTE_LAUNCHER=/usr/local/libexec/jobseek-runner-launch
# Set true only after acceptance/containment checks on the selected host.
JOBSEEK_CODEX_ISOLATION_VERIFIED=false
JOBSEEK_CODEX_MODEL=OWNER_SELECTED_AVAILABLE_MODEL
JOBSEEK_CODEX_EFFORT=OWNER_SELECTED_AVAILABLE_EFFORT
# The same random bridge token is installed in runner config.toml by the owner.
JOBSEEK_CODEX_BRIDGE_TOKEN=REPLACE_FROM_SECRET_STORE
TYPESAFE_API_KEY=REPLACE_FROM_SECRET_STORE

# Private approved career assets, installed separately from public web files.
JOBSEEK_APPROVED_CAREER_ROOT=/var/lib/jobseek/assets
JOBSEEK_TYPST_PATH=/opt/jobseek/bin/typst
