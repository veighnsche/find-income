[Unit]
Description=Private Jobseek web and MCP TLS proxy
After=network-online.target jobseek-api.service
Wants=network-online.target

[Service]
Type=notify
User=jobseek-proxy
Group=jobseek-proxy
Environment=HOME=/var/lib/jobseek-proxy
ExecStart=/usr/bin/caddy run --config /etc/jobseek/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config /etc/jobseek/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5s
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/jobseek-proxy
StateDirectory=jobseek-proxy
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
